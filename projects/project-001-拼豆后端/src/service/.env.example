DATABASE_URL=postgres://pixomosaic_local@127.0.0.1:55440/pixomosaic_backend_local
PAYLOAD_SECRET=replace-with-a-64-character-local-development-secret
# 必填：独立于 PAYLOAD_SECRET，至少 32 字符；用安全随机工具生成，不能提交。
BETTER_AUTH_SECRET=replace-with-a-separate-64-character-random-auth-secret
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
APP_ENV=local
# 本机后端 API 为 3002；PixoMosaic 单图/画板前端为 3050/3100。
PORT=3002
ALLOWED_ORIGINS=http://127.0.0.1:3050,http://127.0.0.1:3100
CSRF_ORIGINS=http://127.0.0.1:3050,http://127.0.0.1:3100
COOKIE_DOMAIN=
COOKIE_SECURE=false
AUTH_BASE_URL=http://127.0.0.1:3002
MAIL_TRANSPORT=local-outbox
# Resend 仅允许获批的 APP_ENV=team-test 使用；真实值只写部署平台密钥配置，绝不提交。
# MAIL_TRANSPORT=resend
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
RESEND_API_KEY=
# 可选：首次团队验证时强制所有邮件只送至一个受控测试收件箱；留空则仍受注册白名单约束。
RESEND_OVERRIDE_RECIPIENT=
# local 环境不限制；team-test/production 必须填写逗号分隔的受邀邮箱，且不能写入真实地址。
REGISTRATION_ALLOWLIST=
# 默认 disabled。自动化测试会自行启用 loopback mock；未来仅在业务方确认真实 Google
# OAuth 后才设为 google，并在部署平台的密钥配置中填写下列两个值。
GOOGLE_OAUTH_MODE=disabled
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
