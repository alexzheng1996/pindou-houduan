{
  "name": "pixomosaic-backend-service",
  "version": "1.0.0",
  "description": "PixoMosaic 独立 Payload 后端（M0 本地基础验证）",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "cleanup:assets": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/purge-expired-assets.ts",
    "cleanup:inventory-imports": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/purge-expired-inventory-import-previews.ts",
    "cleanup:security": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/purge-expired-security-records.ts",
    "cleanup:works": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/purge-expired-works.ts",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --hostname 127.0.0.1",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --hostname 127.0.0.1",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --hostname 127.0.0.1",
    "test": "pnpm run test:int",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-resend": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "better-auth": "1.7.1",
    "cross-env": "^7.0.3",
    "csv-parse": "7.0.2",
    "dotenv": "16.4.7",
    "file-type": "21.3.4",
    "graphql": "^16.8.1",
    "next": "16.3.0",
    "payload": "3.88.0",
    "payload-auth": "3.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "dompurify": "3.4.13",
    "esbuild": "0.25.12",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": "10.33.2"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "monaco-editor>dompurify": "3.4.13"
    }
  }
}
